# Copy to .env and fill in real values. Never commit .env.
# Confirm the target environment with the team before running any suite — see config/README.md.

BASE_URL=https://staging.fee-management.example.com
API_BASE_URL=https://staging.fee-management.example.com/api

# Test account — use a dedicated QA account, never a real user's credentials.
# IMPORTANT: if a password contains "#", wrap the whole value in double quotes.
# dotenv treats an unquoted "#" as a comment marker even with no preceding space,
# silently truncating everything after it (e.g. `PASSWORD=abc#123` becomes just "abc").
ADMIN_USER_EMAIL=
ADMIN_USER_PASSWORD=

STAFF_EMAIL=
STAFF_PASSWORD=

# Centre selected at login for both roles (must match an active centre name in the target env).
TEST_CENTRE=Main Centre

# Set to "staging" or "testing". Suites must refuse to run with ENVIRONMENT=production
# unless the run is explicitly a read-only smoke check.
ENVIRONMENT=testing
