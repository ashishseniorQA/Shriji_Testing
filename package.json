{
  "name": "shriji-qa-framework",
  "version": "1.0.0",
  "private": true,
  "description": "QA automation framework for the Fee Management Workflow System",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:smoke": "playwright test tests/smoke",
    "test:e2e:critical": "playwright test tests/e2e/critical-flows",
    "test:e2e": "playwright test tests/e2e",
    "test:api": "playwright test tests/api/playwright-api",
    "test:regression:critical": "playwright test tests/regression/critical",
    "test:regression": "playwright test tests/regression",
    "test:ui-validation": "playwright test tests/ui-validation",
    "test:security": "playwright test tests/security",
    "test:edge-cases": "playwright test tests/edge-cases",
    "test:db-validation": "playwright test tests/db-validation",
    "report:allure:generate": "allure generate reports/allure-results --clean -o reports/allure-report",
    "report:allure:open": "allure open reports/allure-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^26.1.0",
    "allure-commandline": "^2.30.0",
    "allure-playwright": "^3.0.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "typescript": "^5.6.0",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "@playwright/mcp": "^0.0.77"
  }
}
