# ─────────────────────────────────────────────────────────────
allure-results/
allure-report/
.allure/
reports/allure-results/
reports/allure-report/
reports/screenshots/
reports/videos/
reports/traces/
downloads/

# Ad-hoc run screenshots at the repo root (docs/**/screenshots/ is cited
# evidence and stays tracked)
/screenshots/
*.zip
*.webm
*.trace

# Keep the reports/ scaffold and its docs
!reports/README.md
!reports/flaky-tests-log.md

